{
  "name": "aliya-web",
  "version": "1.0.3",
  "license": "PolyForm-Noncommercial-1.0.0",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "electron:dev": "npm run build && set ALIYA_ELECTRON_DEV=1&& electron .",
    "build:desktop": "cross-env ALIYA_SKIP_PUBLIC_COPY=1 vite build",
    "desktop:build": "npm run build:desktop && electron-builder --win nsis portable",
    "desktop:build:dir": "npm run build:desktop && electron-builder --dir",
    "desktop:pack:dir": "npm run build:desktop && node tools/package_electron_dir.mjs",
    "desktop:build:linux": "npm run build:desktop && electron-builder --linux AppImage",
    "desktop:build:mac": "npm run build:desktop && electron-builder --mac dmg zip",
    "build": "vite build",
    "preview": "vite preview",
    "test:aliya-protocol": "node tools/test_aliya_protocol_paths.mjs",
    "format": "biome format --write",
    "lint": "biome lint",
    "check": "biome check",
    "audit:commands": "py ../tools/audit_wasm_command_coverage.py",
    "audit:flowcharts": "py ../tools/audit_flowchart_integrity.py",
    "audit:radio": "py ../tools/audit_radio_behavior.py",
    "audit:unity-parity": "py ../tools/audit_unity_parity.py",
    "audit:all-blocks": "node tools/audit_all_blocks.mjs 1677",
    "audit:story": "py ../tools/audit_story_inventory.py",
    "replay:smoke": "node tools/replay_smoke.mjs 500",
    "branch:explore": "node tools/explore_branches.mjs 5000 90 24 86400 140",
    "branch:all-flowcharts": "node tools/explore_all_flowcharts.mjs 80 24 12 86400 58",
    "trace:diff": "node tools/diff_unity_trace.mjs",
    "trace:diff:strict": "node tools/diff_unity_trace.mjs --strict-gameplay --strict-matched-path",
    "trace:matrix": "node tools/trace_matrix.mjs",
    "trace:matrix:strict": "node tools/trace_matrix.mjs --strict",
    "trace:coverage": "node tools/audit_trace_coverage.mjs",
    "profile:runtime": "node tools/profile_runtime.mjs",
    "smoke:electron": "npm run build:desktop && node tools/smoke_electron_runtime.mjs",
    "smoke:image-preview": "npm run build:desktop && node tools/smoke_image_preview.mjs",
    "audit:runtime-features": "node tools/audit_runtime_features.mjs",
    "audit:desktop-size": "node tools/audit_desktop_package_size.mjs"
  },
  "build": {
    "appId": "com.aliya.webdesktop",
    "productName": "Aliya",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*.cjs",
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "L0stInFades",
        "repo": "aliya-web"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.games"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    }
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "electron-updater": "^6.8.3",
    "framework7": "^9.0.5",
    "framework7-icons": "^5.0.5",
    "framework7-vue": "^9.0.5",
    "pinia": "^2.1.0",
    "standardized-audio-context": "^25.3.77",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@vitejs/plugin-vue": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^40.9.3",
    "electron-builder": "^26.8.1",
    "playwright": "^1.60.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
